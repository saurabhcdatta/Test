write.csv(panel_sev, file.path(out_dir, "nol_panel_severely_adverse.csv"), row.names = FALSE, na = "")

# quick look: formula NOL (1.20 + Dec Y minus Dec Y+5) by vintage and scenario
nol_quick <- function(p) sapply(split(p, p$vintage), function(d) { d <- d[order(d$period), ]; max(1.20, 1.20 + d$equity_ratio[d$period == 0] - d$equity_ratio[d$period == 10]) })
print(round(rbind(adverse = nol_quick(panel_adv), severely_adverse = nol_quick(panel_sev)), 3))
